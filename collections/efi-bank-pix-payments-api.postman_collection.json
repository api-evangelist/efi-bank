          "name": "List received Pix",
          "request": {
            "name": "List received Pix",
            "description": {
              "content": "Lists received Pix over a date range (Cash-In). Query parameters inicio and fim are mandatory. Modeled on the BACEN Pix API v2 standard. Scope pix.read.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "pix"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "inicio",
                  "value": "<dateTime>",
                  "description": "(Required) Start of the filter interval (RFC 3339 timestamp)."
