              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "webhook",
                ":chave"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "chave",
                  "description": "(Required) The Pix key (chave) the webhook is associated with."
                }
              ]
